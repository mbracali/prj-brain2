{
  "name": "brain2",
  "productName": "BRAIN2",
  "version": "0.1.0",
  "description": "BRAIN2 — Personal Assistant Harness",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:mobile": "tsc --noEmit && cross-env BRAIN2_TARGET=mobile vite build",
    "dist": "npm run build && electron-builder --publish never",
    "android:sync": "npm run build:mobile && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/core": "^7.6.11",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.1",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "material-symbols": "^0.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.11",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "author": "BRAIN2 contributors",
  "homepage": "https://github.com/mbracali/prj-brain2",
  "build": {
    "appId": "app.brain2.desktop",
    "productName": "BRAIN2",
    "copyright": "BRAIN2 contributors — free and open source",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/brain2-server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "artifactName": "BRAIN2-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "../res/brain2-icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "BRAIN2 ${version}"
    },
    "win": {
      "icon": "../res/brain2-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BRAIN2"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "synopsis": "Personal Assistant Harness — vaults, repos, calendars"
    }
  }
}
